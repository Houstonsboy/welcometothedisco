rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Lowercase letters, digits, '_' and '.', 3-20 chars. Also a valid doc ID
    // (rules out reserved `__name__` IDs). Mirrors FirebaseService.validateUsername.
    function isValidUsername(name) {
      return name is string
        && name.matches('^[a-z0-9_.]{3,20}$')
        && !name.matches('^__.*__$');
    }

    // True when, after this write/transaction, `usernames/{name}` belongs to the caller.
    function callerOwnsUsernameAfter(name) {
      return name is string
        && getAfter(/databases/$(database)/documents/usernames/$(name)).data.uid == request.auth.uid;
    }

    // Users: anyone can read; only owner can write their doc.
    // `username_search` is maintained by the onUserWritten Cloud Function only.
    // Setting or changing `username` must claim usernames/{username} in the same
    // transaction (see FirebaseService.createUserProfile / updateCurrentUserProfile).
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId
        && !('username_search' in request.resource.data)
        && callerOwnsUsernameAfter(request.resource.data.get('username', null));
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['username_search'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['username'])
            || callerOwnsUsernameAfter(request.resource.data.get('username', null)));
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Follow notifications subcollection
      // Doc ID = followerUID so one follower can only ever create one doc per recipient.
      match /notifications/{notifId} {
        // Only the recipient reads their own notifications
        allow read: if request.auth != null && request.auth.uid == userId;

        // Follow: sender is the follower — must match followerID.
        // Invite: sender is author — must match authorID; written under recipient userId.
        // Mention: sender is the post author — must match authorID; written under each tagged userId.
        allow create: if request.auth != null && (
          request.resource.data.type == 'follow'
            && request.resource.data.followerID == request.auth.uid
          || request.resource.data.type == 'invite'
            && request.resource.data.authorID == request.auth.uid
            && userId != request.auth.uid
          || request.resource.data.type == 'mention'
            && request.resource.data.authorID == request.auth.uid
            && userId != request.auth.uid
        );

        // Only the recipient can update — restricted to marking as read only
        allow update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      }
    }

    // Username claims: doc ID = lowercase username, `{uid}` = owner. Enforces
    // uniqueness. `get` is public so signup can check availability before the
    // Google sign-in creates an Auth user; `list` stays closed.
    match /usernames/{name} {
      allow get: if true;
      allow list: if false;
      // Claim only a valid, free name, and only together with pointing your own
      // users doc at it (so one account can't hoard names).
      allow create: if request.auth != null
        && isValidUsername(name)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('username', '') == name;
      // Release only your own claim, and only once your users doc has moved off it.
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('username', '') != name;
      allow update: if false;
    }

    // Versus: read for listing; create for authenticated; update by author, invited collaborator, or open join
    match /versus/{docId} {

      /// Album docs use [Author]; artist / collaboration docs use [authorID].
      function versusAuthorUid() {
        return resource.data.get('authorID', resource.data.get('Author', ''));
      }

      function isVersusAuthor() {
        return request.auth != null && request.auth.uid == versusAuthorUid();
      }

      /// Collaboration invitee: may only patch their side + status + comment; cannot reassign author/invite.
      function collaborationCollaboratorUpdate() {
        let beforeAuthor = resource.data.get('authorID', resource.data.get('Author', ''));
        let afterAuthor = request.resource.data.get('authorID', request.resource.data.get('Author', ''));
        let beforeCollab = resource.data.get('collaboratorID', '');
        let afterCollab = request.resource.data.get('collaboratorID', '');
        return request.auth != null
          && resource.data.get('type', '') == 'collaboration'
          && beforeCollab != ''
          && beforeCollab == request.auth.uid
          && afterAuthor == beforeAuthor
          && afterCollab == beforeCollab
          && request.resource.data.get('type', '') == resource.data.get('type', '')
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'artist2ID', 'artist2Name', 'artist2TrackIDs',
                'status', 'collaboratorComment',
                'collaborator_username', 'collaborator_avatar'
              ]);
      }

      /// Returns true when pk is the canonical sorted pair key for id1 and id2.
      /// Accepts only the sorted (lower-lex first) form; the reversed form is rejected.
      function validSortedPairKey(id1, id2, pk) {
        return id1 != '' && id2 != '' && pk != ''
          && ((id1 < id2 && pk == (id1 + '_' + id2))
           || (id2 < id1 && pk == (id2 + '_' + id1))
           || (id1 == id2 && pk == (id1 + '_' + id2)));
      }

      /// pair_key on an open-join update must be the sorted canonical form.
      function validArtistPairKey() {
        let pk = request.resource.data.get('pair_key', '');
        let a1 = request.resource.data.get('artist1ID', '');
        let a2 = request.resource.data.get('artist2ID', '');
        return validSortedPairKey(a1, a2, pk);
      }

      /// At create time, validates artist pair_key and is_self_matchup consistency.
      /// - Open-join (no artist2 yet): passes — pair_key not required yet.
      /// - Self-matchup (a1 == a2): requires is_self_matchup == true and pair_key absent.
      /// - Normal (a1 != a2): requires is_self_matchup == false and valid sorted pair_key.
      function validArtistPairKeyAtCreate() {
        let pk = request.resource.data.get('pair_key', null);
        let et = request.resource.data.get('entity_type', '');
        let a1 = request.resource.data.get('artist1ID', '');
        let a2 = request.resource.data.get('artist2ID', '');
        let sm = request.resource.data.get('is_self_matchup', false);
        return et != 'artist'
          || a2 == ''
          || (a1 == a2 && sm == true && pk == null)
          || (a1 != a2 && sm == false && pk != null && validSortedPairKey(a1, a2, pk));
      }

      /// At create time, validates album pair_key and is_self_matchup consistency.
      function validAlbumPairKeyAtCreate() {
        let pk = request.resource.data.get('pair_key', null);
        let et = request.resource.data.get('entity_type', '');
        let a1 = request.resource.data.get('album1ID', '');
        let a2 = request.resource.data.get('album2ID', '');
        let sm = request.resource.data.get('is_self_matchup', false);
        return et != 'album'
          || a2 == ''
          || (a1 == a2 && sm == true && pk == null)
          || (a1 != a2 && sm == false && pk != null && validSortedPairKey(a1, a2, pk));
      }

      /// is_self_matchup can be set false → true (on join) but never true → false.
      function selfMatchupImmutable() {
        let before = resource.data.get('is_self_matchup', false);
        let after  = request.resource.data.get('is_self_matchup', false);
        return before != true || after == true;
      }

      /// Public artist-versus join: claimant sets themselves as collaborator (was not author).
      /// pair_key and entity_type may be written here (first time only) with validation.
      /// For self-matchup joins, is_self_matchup is set to true and pair_key is omitted.
      function artistVersusOpenJoinUpdate() {
        let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
        let pairKeyAlreadySet = resource.data.get('pair_key', null) != null;
        let pairKeyImmutable = !pairKeyAlreadySet
          || request.resource.data.get('pair_key', null) == resource.data.get('pair_key', null);
        let isSM = request.resource.data.get('is_self_matchup', false);
        let a1 = resource.data.get('artist1ID', '');
        let a2 = request.resource.data.get('artist2ID', '');
        // is_self_matchup flag must match the actual IDs.
        let smConsistent = (a1 == a2) == isSM;
        // pair_key validation depends on whether this is a self-matchup.
        let pkConsistent = isSM
          ? !affectedKeys.hasAny(['pair_key'])
          : (!affectedKeys.hasAny(['pair_key', 'entity_type']) || validArtistPairKey());
        return request.auth != null
          && resource.data.get('type', '') == 'artist'
          && resource.data.get('status', '') == 'open'
          && request.auth.uid != versusAuthorUid()
          && request.resource.data.get('collaboratorID', '') == request.auth.uid
          && request.resource.data.get('status', '') == 'active'
          && pairKeyImmutable
          && smConsistent
          && pkConsistent
          && affectedKeys.hasOnly([
              'collaboratorID', 'artist2ID', 'artist2Name',
              'artist2TrackIDs', 'status', 'pair_key', 'entity_type', 'is_self_matchup'
            ]);
      }

      /// Lazy Spotify image/name cache fill-in: any viewer (not just the author) may
      /// populate these fields, since they're just cached display data keyed off the
      /// doc's own Spotify IDs and are read in the shared Inbox feed (see
      /// FirebaseService.backfillAlbumVersusImages / backfillArtistVersusImages).
      function versusImageCacheBackfill() {
        return request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'album1ImageUrl', 'album1ArtistName',
                'album2ImageUrl', 'album2ArtistName',
                'artist1ImageUrl', 'artist2ImageUrl'
              ]);
      }

      allow read: if request.auth != null;
      allow create: if request.auth != null
        && validArtistPairKeyAtCreate()
        && validAlbumPairKeyAtCreate();
      allow update: if request.auth != null
        && selfMatchupImmutable()
        && (
          // One-off type backfill (e.g. album versus migration)
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['type'])
          || isVersusAuthor()
          || collaborationCollaboratorUpdate()
          || artistVersusOpenJoinUpdate()
          || versusImageCacheBackfill()
        );
      allow delete: if request.auth != null && isVersusAuthor();
    }

    // Rankings: read-only from clients; all writes are by Cloud Functions.
    match /rankings/{entityId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    // Pairs: read-only from clients; all writes are by Cloud Functions.
    match /pairs/{pairKey} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;

      match /voters/{voterId} {
        allow read: if request.auth != null;
        allow create, update, delete: if false;
      }
    }

    // Polls: one poll doc per voter per versus, keyed as {versus_id}_{voter_id}.
    match /polls/{pollId} {
      function isAuthed() {
        return request.auth != null;
      }

      function voterId() {
        return request.resource.data.get('voter_id', '');
      }

      function versusId() {
        return request.resource.data.get('versus_id', '');
      }

      function ownerDocIdMatches() {
        return pollId == (versusId() + '_' + voterId());
      }

      /// pair_key must be the sorted canonical form of entity1_id and entity2_id.
      /// Self-matchup (e1 == e2): pair_key must be absent/null.
      /// Non-self-matchup: pair_key must equal the lower-lex-first sorted key.
      function validPollPairKey() {
        let e1 = request.resource.data.get('entity1_id', '');
        let e2 = request.resource.data.get('entity2_id', '');
        let pk = request.resource.data.get('pair_key', null);
        return (e1 == e2 && pk == null)
          || (e1 != e2 && pk != null
              && ((e1 < e2 && pk == (e1 + '_' + e2))
               || (e2 < e1 && pk == (e2 + '_' + e1))));
      }

      function isOwnerCreate() {
        return isAuthed()
          && voterId() == request.auth.uid
          && versusId() != ''
          && ownerDocIdMatches()
          && validPollPairKey();
      }

      function isOwnerUpdate() {
        return isAuthed()
          && resource.data.get('voter_id', '') == request.auth.uid
          && resource.data.get('versus_id', '') != ''
          && pollId == (
            resource.data.get('versus_id', '') + '_' + resource.data.get('voter_id', '')
          )
          // Immutable identity fields
          && request.resource.data.get('voter_id', '') == resource.data.get('voter_id', '')
          && request.resource.data.get('versus_id', '') == resource.data.get('versus_id', '');
      }

      allow read: if isAuthed();
      allow create: if isOwnerCreate();
      allow update: if isOwnerUpdate() && validPollPairKey();
      allow delete: if false;
    }

    // Posts: global feed + per-author / per-artist streams.
    match /posts/{postId} {
      function isPostAuthor() {
        return request.auth != null
          && resource.data.get('authorID', '') == request.auth.uid;
      }

      allow read: if request.auth != null;

      // Creator must stamp their own uid in authorID.
      allow create: if request.auth != null
        && request.resource.data.get('authorID', '') == request.auth.uid;

      allow update: if request.auth != null && (
        // Post owner can patch any field.
        isPostAuthor()
        // Anyone can bump the remix counter (the remixer is not the post author).
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['Remixcount'])
        // Anyone can bump the share counter.
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['Sharecount'])
      );

      allow delete: if request.auth != null && isPostAuthor();
    }

    // Ranking run audit log: written only by Cloud Functions, never by clients.
    match /ranking_runs/{docId} {
      allow read, write: if false;
    }

    // Playback-gate A/B test events (see lib/services/playback_gate.dart).
    // Write-only event log: a client logs its own attempts, never reads them
    // back (analysis happens via the Firebase console / a script) and can
    // never edit or delete one after the fact.
    match /playback_gate_events/{eventId} {
      allow create: if request.auth != null
        && request.resource.data.get('uid', '') == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
